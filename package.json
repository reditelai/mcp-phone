{
  "name": "mcp-phone",
  "version": "0.3.0",
  "description": "MCP server pro telefonáty: asistent zavolá a přečte vzkaz, volá jen na čísla uložená majitelem",
  "license": "Apache-2.0",
  "author": "Karel Derfl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reditelai/mcp-phone.git"
  },
  "homepage": "https://github.com/reditelai/mcp-phone#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "twilio",
    "voice",
    "phone"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "mcp-phone": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "config.example.json",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@modelcontextprotocol/server": "^2.0.0",
    "ws": "^8.22.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  }
}
